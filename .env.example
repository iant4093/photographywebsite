# Environment Variables
# Copy this file to .env and fill in your values after deploying the SAM template.

# Same-origin CloudFront API path. Keep this relative in production so browser
# traffic cannot bypass the frontend WAF. Use an absolute URL only for a
# reviewed local/staging rollback while origin enforcement remains disabled.
VITE_API_BASE_URL=/api

# Cognito User Pool ID (from SAM output: UserPoolId)
VITE_COGNITO_USER_POOL_ID=us-west-2_XXXXXXXXX

# Cognito App Client ID (from SAM output: UserPoolClientId)
VITE_COGNITO_CLIENT_ID=your-client-id-here

# Media CloudFront hostname without a scheme.
VITE_CLOUDFRONT_DOMAIN=media.example.com

# Public Cloudflare Turnstile site key. The secret key stays server-side.
VITE_TURNSTILE_SITE_KEY=your-public-site-key-here

# CI injects the exact 40-character commit SHA for production builds.
VITE_RELEASE_SHA=

# Public, non-secret Fotomoto integration values. The print origin is isolated
# from Cognito browser storage and receives only five-minute photo capabilities.
VITE_PRINT_ORIGIN=https://prints.iantruongphotography.com
VITE_FOTOMOTO_STORE_ID=f3b4ffed02e8ae181e8de27d1b75195593fbcd49
