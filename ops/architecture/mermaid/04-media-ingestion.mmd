    n10 -->|"enqueue"| n11
    n11 -->|"consume"| n12
    n12 -->|"publish ready"| n13
  end
  style lane1 fill:#FAFBFD,stroke:#DCE3EB,color:#526578
  subgraph lane2["VIDEO TRANSCODING"]
