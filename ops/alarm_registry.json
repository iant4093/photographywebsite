{
  "version": 1,
  "privacyContract": "Website EventBridge signals are fixed allowlisted JSON. Native CloudWatch notifications may contain stable website alarm names, aggregate metrics, and state reasons; no route may contain user data, request bodies, credentials, object keys, media identifiers, request URLs, raw findings, or raw Backup events.",
  "deliveryState": {
    "status": "active-one-confirmed-owner-destination",
    "requiredConfirmedDestinations": 1,
    "primaryOwner": "site-owner",
    "backupOwner": "not-required-for-personal-site",
    "lastEndToEndTestDate": "2026-10-17",
    "testIntervalDays": 90
  },
  "groups": [
    {
      "id": "application-api-health",
      "logicalResourceIds": ["ApiServerErrorAlarm"],
      "severity": "high",
      "route": "security-notification-topic",
      "runbook": "ops/ALARM_REGISTRY.md#application-api-health",
      "autoClose": "CloudWatch metric state only"
    },
    {
      "id": "application-api-latency",
      "logicalResourceIds": ["ApiLatencyAlarm"],
      "severity": "diagnostic",
      "route": "cloudwatch-audit-only",
      "runbook": "ops/ALARM_REGISTRY.md#application-api-health",
      "autoClose": "CloudWatch metric state only"
    },
    {
      "id": "front-door-denial",
      "logicalResourceIds": ["FrontDoorDeniedAlarm"],
      "severity": "audit",
      "route": "cloudwatch-audit-only",
      "runbook": "ops/ALARM_REGISTRY.md#front-door-denial",
      "autoClose": "CloudWatch metric state only"
    },
    {
      "id": "application-async-and-preview",
      "logicalResourceIds": ["AsyncFailureQueueAlarm", "PreviewDeadLetterQueueAlarm", "OriginalComparisonFailureAlarm", "ZipPreparationFailureAlarm", "AlbumWorkDeadLetterQueueAlarm"],
      "severity": "high",
      "route": "security-notification-topic",
      "runbook": "ops/ALARM_REGISTRY.md#application-async-and-preview",
      "autoClose": "CloudWatch metric state only; messages are never automatically deleted or redriven"
    },
    {
      "id": "application-operational-diagnostics",
      "logicalResourceIds": ["PreviewQueueAgeAlarm", "PreviewQueueDepthAlarm", "PreviewWorkerFailureAlarm", "PreviewWorkerErrorsAlarm", "PreviewWorkerDurationAlarm", "PreviewWorkerThrottleAlarm", "PreviewMetadataSystemErrorsAlarm", "PreviewMetadataThrottleAlarm", "HoverPreviewRefreshQueueAgeAlarm", "HoverPreviewManifestBuilderErrorsAlarm", "HoverPreviewManifestFailureAlarm", "OriginalIndexRefreshErrorsAlarm", "AlbumWorkQueueAgeAlarm"],
      "severity": "diagnostic",
      "route": "cloudwatch-audit-only",
      "runbook": "ops/ALARM_REGISTRY.md#application-async-and-preview",
      "autoClose": "CloudWatch metric state only"
    },
    {
      "id": "authentication-and-authorization",
      "logicalResourceIds": ["LoginThrottleAlarm", "LoginDeniedAlarm", "ApiAuthorizationDeniedAlarm"],
      "severity": "diagnostic",
      "route": "cloudwatch-audit-only",
      "runbook": "ops/ALARM_REGISTRY.md#authentication-and-authorization",
      "autoClose": "CloudWatch metric state only"
    },
    {
      "id": "application-audit-failure",
      "logicalResourceIds": ["AuditFailureAlarm"],
      "severity": "audit",
      "route": "cloudwatch-audit-only",
      "runbook": "ops/ALARM_REGISTRY.md#application-audit-failure",
      "autoClose": "CloudWatch metric state only; incident disposition remains open until logging is proven"
    },
    {
      "id": "account-root-activity",
      "logicalResourceIds": ["RootActivityAlarm"],
      "severity": "critical",
      "route": "security-notification-topic",
      "runbook": "ops/ALARM_REGISTRY.md#account-identity-and-encryption-change",
      "autoClose": "Never auto-close without an approved change or incident record"
    },
    {
      "id": "account-identity-and-encryption-change",
      "logicalResourceIds": ["IamChangeAlarm", "KmsChangeAlarm"],
      "severity": "audit",
      "route": "cloudwatch-audit-only",
      "runbook": "ops/ALARM_REGISTRY.md#account-identity-and-encryption-change",
      "autoClose": "Never auto-close without an approved change or incident record"
    },
    {
      "id": "trail-and-notification-change",
      "logicalResourceIds": ["CloudTrailChangeAlarm", "SecurityRoutingChangeAlarm"],
      "severity": "audit",
      "route": "cloudwatch-audit-only",
      "runbook": "ops/ALARM_REGISTRY.md#trail-and-notification-change",
      "autoClose": "Never auto-close without delivery and evidence verification"
    },
    {
      "id": "website-notification-delivery",
      "logicalResourceIds": ["SecurityEventDlqAlarm"],
      "severity": "high",
      "route": "security-notification-topic",
      "runbook": "ops/ALARM_REGISTRY.md#website-notification-delivery",
      "autoClose": "CloudWatch metric state only; messages are never automatically deleted"
    },
    {
      "id": "security-service-change",
      "logicalResourceIds": ["SecurityServiceChangeAlarm"],
      "severity": "audit",
      "route": "cloudwatch-audit-only",
      "runbook": "ops/ALARM_REGISTRY.md#security-service-change",
      "autoClose": "Never auto-close without Config, GuardDuty, Security Hub, Inspector, and analyzer verification"
    },
    {
      "id": "data-protection-change",
      "logicalResourceIds": ["DataProtectionChangeAlarm"],
      "severity": "audit",
      "route": "cloudwatch-audit-only",
      "runbook": "ops/ALARM_REGISTRY.md#data-protection-change",
      "autoClose": "Never auto-close without live S3, DynamoDB, backup, and logging checks"
    },
    {
      "id": "backup-job-failure",
      "logicalResourceIds": ["BackupJobFailureRule"],
      "severity": "high",
      "route": "security-notification-topic",
      "runbook": "ops/ALARM_REGISTRY.md#backup-job-failure",
      "autoClose": "Never; require a later successful protected backup and recorded disposition"
    },
    {
      "id": "backup-freshness",
      "logicalResourceIds": ["BackupFreshnessAlarm"],
      "severity": "critical",
      "route": "security-notification-topic",
      "runbook": "ops/ALARM_REGISTRY.md#backup-freshness",
      "autoClose": "CloudWatch state only; close the incident only after every exact source and configured replica resource has a fresh completed recovery point"
    },
    {
      "id": "edge-health",
      "logicalResourceIds": ["FrontendFiveXxAlarm", "MediaFiveXxAlarm", "WafAlarmForwardRule"],
      "severity": "high",
      "route": "security-notification-topic-via-cross-region-validated-signal-queue",
      "runbook": "ops/ALARM_REGISTRY.md#edge-health",
      "autoClose": "CloudWatch metric state only"
    },
    {
      "id": "monthly-spend",
      "logicalResourceIds": ["MonthlySecurityAndObservabilityBudget.Actual100Percent", "MonthlySecurityAndObservabilityBudget.Forecasted100Percent"],
      "severity": "high",
      "route": "aws-budgets-owner-email-when-configured",
      "runbook": "ops/ALARM_REGISTRY.md#monthly-spend",
      "autoClose": "AWS Budgets state only; close after the cost driver is identified and the limit or spend is corrected"
    }
  ]
}
